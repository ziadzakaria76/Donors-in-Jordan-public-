# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Microsoft Graph (report delivery) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Mailbox the report is sent *from* (UPN or object id)
GRAPH_SENDER=

# --- Recipients (comma-separated) ---
REPORT_TO=
REPORT_CC=

# --- SAM.gov ---
# Free key from https://sam.gov/ ; approval takes 1-4 weeks.
# Leave blank and the SAM.gov portal stays disabled instead of failing the run.
SAM_API_KEY=

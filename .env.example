# Copy to .env and fill in. .env is gitignored and must never be committed.
# Nothing here is required to produce the report files; both entries are optional.

# --- SAM.gov ---
# Free key from https://sam.gov/ ; approval takes 1-4 weeks.
# Leave blank and the SAM.gov portal stays disabled instead of failing the run.
SAM_API_KEY=

# --- JavaScript fallback (optional) ---
# Only needed where `playwright install chromium` cannot download a browser and
# the machine ships its own. An empty value is ignored.
PLAYWRIGHT_CHROMIUM_PATH=

# ---------------------------------------------------------------------------
# Jordan Tender Monitor -- credentials template
#
# Copy this file to .env and fill in the values you have. Every variable is
# optional: anything left blank simply disables the feature that needs it.
#
#   cp .env.example .env
#
# .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------


# ===========================================================================
# 1. MICROSOFT GRAPH  (recommended for Microsoft 365 / Exchange Online)
# ===========================================================================
# How to obtain these (needs an Azure AD / Entra ID administrator):
#   1. Azure Portal -> Microsoft Entra ID -> App registrations -> New registration
#      Name: "Jordan Tender Monitor", single tenant.
#   2. Copy "Directory (tenant) ID"    -> AZURE_TENANT_ID
#      Copy "Application (client) ID"  -> AZURE_CLIENT_ID
#   3. Certificates & secrets -> New client secret -> copy the VALUE (not the ID)
#                                                   -> AZURE_CLIENT_SECRET
#   4. API permissions -> Add a permission -> Microsoft Graph ->
#      APPLICATION permissions -> Mail.Send -> Add -> then "Grant admin consent".
#   5. Ask IT to scope the app with an ApplicationAccessPolicy so it can only
#      send as the mailbox below (least privilege; Mail.Send is otherwise
#      tenant-wide).
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret-value-here

# Mailbox the report is sent FROM. Must exist in the tenant and be covered by
# the access policy above.
SENDER_EMAIL=reports@example.com


# ===========================================================================
# 2. OFFICE 365 SMTP  (automatic fallback if Graph is not configured)
# ===========================================================================
# Requires SMTP AUTH to be enabled on the mailbox and an app password, both of
# which many IT departments disable by default. Check before relying on this.
#   App password: https://mysignins.microsoft.com/security-info
SMTP_USER=reports@example.com
SMTP_PASS=your-app-password-here
SMTP_HOST=smtp.office365.com
SMTP_PORT=587


# ===========================================================================
# 3. SAM.GOV API KEY  (US government / former USAID opportunities)
# ===========================================================================
# Free, but approval takes 1-4 weeks:
#   1. https://sam.gov -> Sign In -> create a login.gov account
#   2. Complete the individual registration
#   3. Account Details -> Request Public API Key
#   4. Paste the key below.
# Leave blank to skip SAM.gov -- the run continues and reports it as unavailable.
SAM_API_KEY=


# ===========================================================================
# 4. REPORT RECIPIENTS
# ===========================================================================
# Who receives the report. Comma-separate for several addresses.
# Leave blank and the run saves to output/ instead of sending.
EMAIL_RECIPIENTS=you@example.com
EMAIL_CC=

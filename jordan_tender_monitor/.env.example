# Copy to .env and fill in. NEVER commit .env -- it is gitignored, and this
# repository is public.

# ---------------------------------------------------------------------------
# Recipients (comma-separated). These live here rather than in config.py so
# that no colleague's work address is ever committed to a public repository.
# With none set, the report is written to output/ and no mail is sent.
# ---------------------------------------------------------------------------
EMAIL_RECIPIENTS=you@example.com,colleague@example.com
EMAIL_CC=

# ---------------------------------------------------------------------------
# Microsoft Graph (the configured delivery method).
#
# SECURITY: if Mail.Send is granted as an APPLICATION permission it is
# TENANT-WIDE -- this app registration can then send mail as ANY mailbox in
# your organisation, so a leaked client secret becomes an organisation-wide
# mail-sending capability. Scope it to one mailbox:
#
#   New-ApplicationAccessPolicy -AppId <client-id> `
#     -PolicyScopeGroupId tender-monitor@yourdomain.com `
#     -AccessRight RestrictAccess `
#     -Description "Restrict Jordan tender monitor to its own mailbox"
#
# Prefer a delegated permission if your tenant allows it.
# ---------------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SENDER_EMAIL=tender-monitor@yourdomain.com

# ---------------------------------------------------------------------------
# Office 365 SMTP -- the fallback. Most tenants disable basic auth by default,
# so this will often fail with an authentication error even when the password
# is correct. Leave blank to skip straight to writing files.
# ---------------------------------------------------------------------------
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587

# ---------------------------------------------------------------------------
# SAM.gov API key. Free, but approval takes one to four weeks. Until this is
# set the portal reports as "not configured" rather than "unavailable" -- a
# paperwork delay is not a broken scraper.
# Request one at https://sam.gov
# ---------------------------------------------------------------------------
SAM_API_KEY=

# ---------------------------------------------------------------------------
# Optional state overrides, used by the tests and --self-test so diagnostics
# never touch the real seen-tenders database. You do not normally set these.
# ---------------------------------------------------------------------------
# JTM_DATA_DIR=
# JTM_OUTPUT_DIR=
# JTM_SEEN_DB=

# Credentials
.env
.env.local

# Local databases
*.db

# Generated reports -- keep the directory, ignore its contents.
# The ** prefix matters: a pattern containing a slash is anchored to this
# file's directory, so a bare "output/*" would only cover a top-level output/
# and would happily commit every report written to
# jordan_tender_monitor/output/.
**/output/*
!**/output/.gitkeep

# Local state -- keep the directory, ignore the database
**/data/*
!**/data/.gitkeep

# Logs
*.log

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Captured live pages -- may embed contact details from real notices
jordan_tender_monitor/tests/fixtures/live/

# Android
#
# The keystore and its password NEVER go in the repository -- a signing key in
# git is a signing key anyone who ever cloned it can use, and rotating it means
# every existing install can no longer be updated. If release signing is set
# up, both live in repository secrets. See android/ANDROID.md.
*.jks
*.keystore
android/local.properties
android/**/build/
android/.gradle/
android/.idea/
android/out/
android/app/release/
local.properties

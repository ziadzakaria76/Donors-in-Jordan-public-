# Cloudflare Pages response headers.
# Same policy as netlify.toml and vercel.json, in the format Pages reads.
# Pages serves 404.html for unmatched paths on its own, so there is no
# _redirects file — and a www -> apex redirect cannot live here either; it is a
# Redirect Rule in the Cloudflare dashboard (README -> "Deploy it").

# Fonts and images are content-hashed by name and never edited in place, so
# they can be cached for a year.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
